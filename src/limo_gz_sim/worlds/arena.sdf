<?xml version="1.0" ?>
<sdf version="1.8">
  <world name="arena">
    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <plugin filename="ignition-gazebo-physics-system" name="ignition::gazebo::systems::Physics"/>
    <plugin filename="ignition-gazebo-user-commands-system" name="ignition::gazebo::systems::UserCommands"/>
    <plugin filename="ignition-gazebo-scene-broadcaster-system" name="ignition::gazebo::systems::SceneBroadcaster"/>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>20 20</size>
            </plane>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>20 20</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.8 0.8 0.8 1</ambient>
            <diffuse>0.8 0.8 0.8 1</diffuse>
            <specular>0.8 0.8 0.8 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- 10m x 10m Perimeter Walls (Origin 0,0,0 is completely clear) -->
    <model name="arena_walls">
      <static>true</static>
      <link name="north_wall">
        <pose>5.0 0 0.25 0 0 0</pose>
        <collision name="c"><geometry><box><size>0.15 10.15 0.5</size></box></geometry></collision>
        <visual name="v">
          <geometry><box><size>0.15 10.15 0.5</size></box></geometry>
          <material><ambient>0.3 0.3 0.35 1</ambient><diffuse>0.4 0.4 0.45 1</diffuse></material>
        </visual>
      </link>
      <link name="south_wall">
        <pose>-5.0 0 0.25 0 0 0</pose>
        <collision name="c"><geometry><box><size>0.15 10.15 0.5</size></box></geometry></collision>
        <visual name="v">
          <geometry><box><size>0.15 10.15 0.5</size></box></geometry>
          <material><ambient>0.3 0.3 0.35 1</ambient><diffuse>0.4 0.4 0.45 1</diffuse></material>
        </visual>
      </link>
      <link name="east_wall">
        <pose>0 -5.0 0.25 0 0 0</pose>
        <collision name="c"><geometry><box><size>10.15 0.15 0.5</size></box></geometry></collision>
        <visual name="v">
          <geometry><box><size>10.15 0.15 0.5</size></box></geometry>
          <material><ambient>0.3 0.3 0.35 1</ambient><diffuse>0.4 0.4 0.45 1</diffuse></material>
        </visual>
      </link>
      <link name="west_wall">
        <pose>0 5.0 0.25 0 0 0</pose>
        <collision name="c"><geometry><box><size>10.15 0.15 0.5</size></box></geometry></collision>
        <visual name="v">
          <geometry><box><size>10.15 0.15 0.5</size></box></geometry>
          <material><ambient>0.3 0.3 0.35 1</ambient><diffuse>0.4 0.4 0.45 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- 4 Reference Pillars away from (0,0,0) for LiDAR & Trajectory testing -->
    <model name="pillars">
      <static>true</static>
      <link name="pillar_fl">
        <pose>2.5 1.5 0.25 0 0 0</pose>
        <collision name="c"><geometry><cylinder><radius>0.15</radius><length>0.5</length></cylinder></geometry></collision>
        <visual name="v">
          <geometry><cylinder><radius>0.15</radius><length>0.5</length></cylinder></geometry>
          <material><ambient>0.8 0.2 0.2 1</ambient><diffuse>0.8 0.2 0.2 1</diffuse></material>
        </visual>
      </link>
      <link name="pillar_fr">
        <pose>2.5 -1.5 0.25 0 0 0</pose>
        <collision name="c"><geometry><cylinder><radius>0.15</radius><length>0.5</length></cylinder></geometry></collision>
        <visual name="v">
          <geometry><cylinder><radius>0.15</radius><length>0.5</length></cylinder></geometry>
          <material><ambient>0.2 0.6 0.8 1</ambient><diffuse>0.2 0.6 0.8 1</diffuse></material>
        </visual>
      </link>
      <link name="pillar_rl">
        <pose>-2.5 1.5 0.25 0 0 0</pose>
        <collision name="c"><geometry><cylinder><radius>0.15</radius><length>0.5</length></cylinder></geometry></collision>
        <visual name="v">
          <geometry><cylinder><radius>0.15</radius><length>0.5</length></cylinder></geometry>
          <material><ambient>0.2 0.8 0.3 1</ambient><diffuse>0.2 0.8 0.3 1</diffuse></material>
        </visual>
      </link>
      <link name="pillar_rr">
        <pose>-2.5 -1.5 0.25 0 0 0</pose>
        <collision name="c"><geometry><cylinder><radius>0.15</radius><length>0.5</length></cylinder></geometry></collision>
        <visual name="v">
          <geometry><cylinder><radius>0.15</radius><length>0.5</length></cylinder></geometry>
          <material><ambient>0.8 0.6 0.1 1</ambient><diffuse>0.8 0.6 0.1 1</diffuse></material>
        </visual>
      </link>
    </model>
  </world>
</sdf>
